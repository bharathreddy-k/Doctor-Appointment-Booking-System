# Backend Configuration

# MongoDB Connection String
# Get from: https://www.mongodb.com/cloud/atlas
# Paste your full MongoDB Atlas URI from the Atlas dashboard
MONGODB_URI=your_mongodb_atlas_uri_here

# JWT Secret for authentication
# Generate a strong secret: use a random string or run: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Doctor Account Credentials (for demo/initial setup)
DOCTOR_EMAIL=doctor@example.com
DOCTOR_PASSWORD=password123

# Environment
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL (for CORS)
# Local: http://localhost:3000
# Production: https://your-frontend-url.vercel.app
FRONTEND_URL=http://localhost:3000

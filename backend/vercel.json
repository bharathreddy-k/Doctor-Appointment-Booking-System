{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "env": {
    "MONGODB_URI": "",
    "JWT_SECRET": "",
    "FRONTEND_URL": "",
    "NODE_ENV": "production"
  }
}
